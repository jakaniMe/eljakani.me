---
import { Icon } from 'astro-icon/components';
import Gallery from './Gallery.astro';
import { talks } from '../data/profile';
---

<section id="talks" class="py-16">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary/70">Speaking</p>
            <h3 class="text-4xl font-bold text-foreground font-alt">Talks & Conferences</h3>
        </div>
        <div class="flex gap-3 text-sm text-foreground/70">
            <span class="rounded-full border bg-background px-3 py-1.5">{talks.length} talks</span>
            <span class="rounded-full border bg-background px-3 py-1.5">Devoxx · DevFest · GDSC</span>
        </div>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
        {talks.map((talk) => (
            <article class="flex flex-col rounded-2xl border bg-gradient-to-br from-background to-muted/25 p-5 sm:p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-xl">
                <div class="flex items-center justify-between gap-3 mb-3">
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
                        <Icon name="lucide:mic" class="h-3.5 w-3.5" />
                        {talk.event}
                    </span>
                    <span class="text-sm font-semibold text-signal shrink-0">{talk.year}</span>
                </div>

                <h4 class="text-xl font-semibold leading-snug text-foreground font-alt">
                    {talk.link ? (
                        <a href={talk.link} target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-primary transition-colors">{talk.title}</a>
                    ) : (
                        talk.title
                    )}
                </h4>

                <p class="mt-2 flex items-center gap-1.5 text-xs text-foreground/60">
                    <Icon name="lucide:map-pin" class="h-3.5 w-3.5 text-primary/70" />
                    {talk.place}
                </p>

                {talk.blurb && (
                    <p class="mt-3 flex-1 text-sm leading-relaxed text-foreground/75">{talk.blurb}</p>
                )}

                <Gallery images={talk.images} />
            </article>
        ))}
    </div>
</section>
