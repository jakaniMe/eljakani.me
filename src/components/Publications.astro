---
import { Icon } from 'astro-icon/components';
import { publications, profile } from '../data/profile';

// Split an author string on **your name** markers so your name renders bold.
function authorSegments(authors: string): { text: string; bold: boolean }[] {
    return authors
        .split("**")
        .map((text, i) => ({ text, bold: i % 2 === 1 }))
        .filter((seg) => seg.text.length > 0);
}

const linkLabels: Record<string, string> = {
    doi: "DOI",
    pdf: "PDF",
    preprint: "Preprint",
    view: "View",
};

// "Full list" pointer appears once you uncomment scholar / researchgate in profile.ts
const fullListUrl = profile.links.scholar ?? profile.links.researchgate;
const fullListLabel = profile.links.scholar ? "Google Scholar" : "ResearchGate";
---

<section id="publications" class="py-16">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary/70">Research output</p>
            <h3 class="text-4xl font-bold text-foreground font-alt">Publications</h3>
        </div>
        <div class="flex gap-3 text-sm text-foreground/70">
            <span class="rounded-full border bg-background px-3 py-1.5">{publications.length} selected</span>
        </div>
    </div>

    <div class="space-y-5">
        {publications.map((pub) => (
            <article class="rounded-2xl border bg-gradient-to-br from-background to-muted/25 p-5 sm:p-6 shadow-sm transition-all duration-300 hover:border-primary/30 hover:shadow-xl">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-2.5 py-1 text-xs font-medium text-primary">
                        <Icon name="lucide:book-open" class="h-3.5 w-3.5" />
                        {pub.kind}
                    </span>
                    {pub.venue !== pub.kind && (
                        <span class="text-sm text-foreground/70">{pub.venue}</span>
                    )}
                    <span class="text-sm font-semibold text-signal">{pub.year}</span>
                </div>

                <h4 class="text-xl font-semibold leading-snug text-foreground font-alt mb-2">
                    {pub.title}
                </h4>

                <p class="text-sm text-foreground/70 mb-3">
                    {authorSegments(pub.authors).map((seg) =>
                        seg.bold ? <strong class="text-foreground">{seg.text}</strong> : <Fragment>{seg.text}</Fragment>
                    )}
                </p>

                {pub.badges && pub.badges.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-3">
                        {pub.badges.map((b) => (
                            <span class="rounded-full bg-primary/10 border border-primary/20 px-2.5 py-1 text-xs font-medium text-primary">{b}</span>
                        ))}
                    </div>
                )}

     

                <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex flex-wrap gap-2">
                        {pub.tags?.map((tag) => (
                            <span class="rounded-full bg-muted px-2.5 py-1 text-xs text-foreground/70">{tag}</span>
                        ))}
                    </div>
                    {pub.links && pub.links.length > 0 && (
                        <div class="flex gap-2">
                            {pub.links.map((l) => (
                                <a
                                    href={l.href}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-1.5 rounded-full border border-primary/30 px-3 py-1.5 text-xs font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground"
                                >
                                    <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
                                    {linkLabels[l.type] ?? l.type}
                                </a>
                            ))}
                        </div>
                    )}
                </div>
            </article>
        ))}
    </div>

    {fullListUrl && (
        <p class="mt-6 text-sm text-foreground/70">
            Full list on
            <a class="text-primary hover:underline" href={fullListUrl} target="_blank" rel="noopener noreferrer"> {fullListLabel} ↗</a>
        </p>
    )}
</section>

<style>
    .pub-abstract summary::-webkit-details-marker {
        display: none;
    }
    .pub-abstract[open] :global(.abs-chevron) {
        transform: rotate(180deg);
    }
</style>
