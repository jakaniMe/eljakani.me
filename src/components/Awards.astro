---
import { Icon } from 'astro-icon/components';
import Gallery from './Gallery.astro';
import { prizes } from '../data/profile';
---

<section id="awards" class="py-16">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-primary/70">Recognition</p>
            <h3 class="text-4xl font-bold text-foreground font-alt">Prizes & Awards</h3>
        </div>
    </div>

    <div class="space-y-5">
        {prizes.map((prize) => (
            <article class="rounded-2xl border bg-gradient-to-br from-background to-muted/25 p-5 sm:p-6 shadow-sm transition-all duration-300 hover:border-primary/30 hover:shadow-xl">
                <div class="flex items-start gap-4">
                    <div class="bg-primary/10 p-3 rounded-full shrink-0 hidden sm:flex">
                        <Icon name="lucide:trophy" class="w-6 h-6 text-primary" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-1">
                            <span class="text-sm font-semibold text-signal">{prize.year}</span>
                            <span class="text-sm text-foreground/60">{prize.org}</span>
                        </div>
                        <h4 class="text-xl font-semibold leading-snug text-foreground font-alt mb-2">{prize.title}</h4>
                        <p class="text-sm leading-relaxed text-foreground/75">{prize.detail}</p>
                        <Gallery images={prize.images} />
                    </div>
                </div>
            </article>
        ))}
    </div>
</section>
