# Copy to .env and adjust.  cp .env.example .env

# ---------- Logging / security ----------
LOG_LEVEL=INFO
# Clients must send this (X-API-Key header, or ?api_key= for the WebSocket). Empty = no auth.
API_KEY=change-me
# Comma-separated origins allowed to call the HTTP API from a browser
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------- ASR model ----------
ASR_ENGINE=faster-whisper
# Hugging Face repo id (downloaded once into MODELS_DIR) ...
WHISPER_MODEL_SIZE=OdyAsh/faster-whisper-base-ar-quran
# ... or a local CTranslate2 model folder (takes precedence when set)
WHISPER_MODEL_DIR=
# int8 on CPU; float16 on an NVIDIA GPU (WHISPER_DEVICE=cuda)
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_CPU_THREADS=4
# 1 = greedy (fastest). 5 = a little more accurate, ~2x slower.
WHISPER_BEAM_SIZE=1
WHISPER_VAD=1
# How many reciters can be decoded at the same time (each uses WHISPER_CPU_THREADS cores)
ASR_WORKERS=1

# ---------- Streaming ----------
# Decode the new audio every N ms. Lower = more responsive, more CPU.
STREAM_STEP_MS=1000
# Audio kept un-committed before being trimmed at the last stable word (seconds, < 25)
STREAM_MAX_BUFFER_S=12

# ---------- Optional ----------
# JSON file overriding the Easy/Medium/Strict thresholds, e.g. ./profiles.json
PROFILES_PATH=
